# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

build/
dist/
*.egg-info/
.eggs/
wheels/
MANIFEST

.venv/
venv/
env/
ENV/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

.python-version

# --- Node / frontend -------------------------------------------------------
node_modules/
web/dist/
web/.vite/
.eslintcache
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build output copied into the Python package. Built, never committed.
src/physiosync/web/

# --- Runtime data ----------------------------------------------------------
# Recordings live under $PHYSIOSYNC_DATA, outside the repo. These patterns
# catch the case of someone pointing the data root at the working tree.
physiosync-data/
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.parquet
*.jsonl
*.jsonl.gz

# Fixtures are the exception: the replay adapter and the sync tests depend on
# them, so they are committed.
!fixtures/**

# --- Local configuration ---------------------------------------------------
.env
.env.local
*.local

# --- Editors and OS --------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Thesis / scratch ------------------------------------------------------
scratch/
notebooks/*.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Vendored third-party binaries. MUST come last: these negations override the
# *.so / *.pyd / *.dll / *.dylib patterns above.
# ---------------------------------------------------------------------------
!src/physiosync/vendor/
!src/physiosync/vendor/**